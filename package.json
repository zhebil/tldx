{
  "name": "tldsl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CLI + local viewer turning a plain-text DSL into a live tldraw canvas.",
  "bin": {
    "tldsl": "dist/cli/main.js"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern src",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs --no-progress src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:cli": "tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "build:viewer": "vite build",
    "build": "npm run build:cli && npm run build:viewer",
    "dev:cli": "tsx src/cli/main.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:deps && npm run test"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dependency-cruiser": "^16.4.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "playwright": "^1.62.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "chokidar": "^5.0.0",
    "elkjs": "^0.11.1",
    "esbuild": "^0.28.2",
    "hono": "^4.12.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "^3.15.6"
  }
}
