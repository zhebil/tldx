node_modules/
dist/
build/
.DS_Store
*.log
.env
.env.local
.idea/
.vscode/

.playwright-mcp/

# .claude is tracked - skills, commands and shared settings are project source.
# Only the machine-local and generated parts stay out.
.claude/worktrees/
.claude/settings.local.json

# overlay sidecars are generated, never source
*.overlay.json

# Debug renders belong in a temp dir, never the repo.
*.png

# Local-only bug repros - a scratch ledger, not shipped source
examples/repro/

# Reports, baselines and scratch notes never belong in the repo
docs/*-report.md
docs/baseline*.md
docs/plan.md
