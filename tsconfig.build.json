{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": [
    "src/viewer",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.fake.ts",
    "**/*.contract.ts"
  ]
}
